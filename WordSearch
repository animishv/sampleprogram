Problem Statement

You are given:A 2D board of characters. A word.

Determine whether the word exists in the board.

Rules: You may move: Up, Down, Left, Right, You cannot move diagonally., You cannot use the same cell twice in one search.

Example 1 Board
A B C E
S F C S
A D E E

Word : "ABCCED"
Answer : true

public static boolean findWord(char[][] matrix, String source){
	for(int i = 0; i < matrix.length; i++){
		for(int j = 0; j < matrix[0].length; j++){
			if(matchWord(matrix, source, i, j, 0)){
				return true;
			}
		}
	}
	return false;
}

public static boolean matchWord(char[][] matrix, String source, int i, int j, int K){
	if(i<0 ||j < 0 || i >= matrix.length || j >= matrix[0].length || matrix[i)[j] != source.charAt(K)){
		return false;
	}
		char temp = matrix[i][j];	
		matrix[i][j] = '#';
		if(K == source.length() - 1){
			return true;
		} else if(matchWord(matrix, source, i-1, j, K + 1) ||
			matchWord(matrix, source, i+1, j, K + 1) ||
			matchWord(matrix, source, i, j+1, K + 1) ||
			matchWord(matrix, source, i, j-1, K + 1)){
			return true;
		}
           matrix[i][j] = temp;
           return false;
}

