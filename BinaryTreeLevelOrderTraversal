Given a binary tree, return the nodes level by level.
Example
Suppose the tree is

          3
        /   \
       9     20
            /  \
          15    7

Return [[3], [9,20], [15,7]]

public static List<List<Integer>> levelsBt(TreeNode root){
    
    List<List<Integer>> result = new ArrayList<List<Integer>>();
    
    if(root == null){
        return result;
    }
    
    Queue<TreeNode> queue = new LinkedList<>();
    queue.offer(root);
        
    while(!queue.isEmpty()){
        
        int size = queue.size();
        
        List<Integer> currentLevel = new ArrayList<>();
        
        for(int i = 0; i < size; i++){
            TreeNode current = queue.poll();
        
            currentLevel.add(current.val)
            
            if(root.left != null){
                queue.offer(current.left);
            }
            if(root.right != null){
                queue.offer(current.right);
            }
        }
        result.add(currentLevel);
    }
    return result
}
  
  
  


