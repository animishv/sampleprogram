static boolean isCircular(Node head) {
        if (head == null)
            return true;

        ListNode slow = head;
        ListNode fast = head.next;

        // Traverse the linked list with two pointers
        while (fast != null && fast.next != null) {
            if (slow == fast)
                return true;
            slow = slow.next;
            fast = fast.next.next;
        }
        return false;
    }
